<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Markdig" Version="1.3.2" />
      <PackageReference Include="Stubble.Core" Version="1.10.8" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Resources\Templates\**" LinkBase="Resources\Templates\" CopyToOutputDirectory="Always"/>
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="Resources\Content\**" LinkBase="Resources\Content\" CopyToOutputDirectory="Always"/>
    </ItemGroup>

    <Target Name="AfterBuild">
        <Copy SourceFiles="@(TemplateData)" DestinationFiles="@(TemplateData->'$(OutDir)\Resources\%(RecursiveDir)%(Filename)%(Extension)')"/>
    </Target>
    
</Project>
